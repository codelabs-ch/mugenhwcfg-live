timeout 10

title mugenhwcfg-headless
	kernel hdb0:/live/vmlinuz boot=live components intel_iommu=on iomem=relaxed nomodeset persistence headless
	initrd hdb0:/live/initrd.img
	boot

title mugenhwcfg-live
	kernel hdb0:/live/vmlinuz boot=live components intel_iommu=on iomem=relaxed nomodeset persistence
	initrd hdb0:/live/initrd.img
	boot
