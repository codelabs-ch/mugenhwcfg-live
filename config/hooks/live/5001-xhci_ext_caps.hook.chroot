#!/bin/sh

set -e

mkdir -p /opt
mkdir -p /tmp/xhci_extcap

wget -q "https://git.codelabs.ch/cgit/libxhcidbg.git/plain/misc/xhci_ext_caps.c?h=muen&id=fd213202d1dea095dfbd2b6a0704b6fa61482d7f" -O /tmp/xhci_extcap/xhci_ext_caps.c

gcc -o /opt/xhci_ext_caps /tmp/xhci_extcap/xhci_ext_caps.c
rm -rf /tmp/xhci_extcap
